# Configuración local. Copiar a .env en la raíz, sin subirlo a Git.
GTP_HOST=127.0.0.1
GTP_PORT=8000
GTP_TIMEZONE=Europe/Madrid
# Uso de la cuenta ChatGPT; sin API facturada alternativa.
GTP_COACH_PROVIDER=chatgpt_pro

GTP_DATA_DIR=data
GTP_INITIAL_DAYS=90
GTP_SYNC_HOUR=3
GTP_AUTO_SYNC=true

# Solo para despliegue HTTPS; dejar sin definir en desarrollo local.
# GTP_PUBLIC_ORIGIN=https://entrenamiento.example.com
# GTP_TRUSTED_PROXY_IPS=127.0.0.1,::1
